<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.recipe_app.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_home_to_recipeDetails"
            app:destination="@id/recipeDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.recipe_app.ui.common.Placeholder"
        android:label="@string/nav_search" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.recipe_app.ui.common.Placeholder"
        android:label="@string/nav_favs" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.recipe_app.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_recipeDetails"
            app:destination="@id/recipeDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.recipe_app.ui.common.Placeholder"
        android:label="@string/notifications" />

    <fragment
        android:id="@+id/addRecipeFragment"
        android:name="com.example.recipe_app.ui.common.Placeholder"
        android:label="@string/add_recipe" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.recipe_app.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_forgotPassword"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.recipe_app.ForgotPasswordFragment"
        android:label="Forgot password"
        tools:layout="@layout/fragment_forgot_password" />

    <fragment
        android:id="@+id/recipeDetailsFragment"
        android:name="com.example.recipe_app.RecipeDetailsFragment"
        android:label="Recipe details"
        tools:layout="@layout/fragment_recipe_details" />

</navigation>