<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_m"
    android:minHeight="90dp"
    app:cardCornerRadius="@dimen/card_corner_radius">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageRecipe"
            android:layout_width="90dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/recipe_image_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/RecipeImageShape" />

        <ImageView
            android:id="@+id/imageHeart"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:padding="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_heart_outline"
            android:background="@drawable/bg_heart_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textDishType"
            style="@style/TextAppearance.App.Eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            app:layout_constraintEnd_toStartOf="@id/imageHeart"
            app:layout_constraintStart_toEndOf="@id/imageRecipe"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="MAINS" />

        <TextView
            android:id="@+id/textName"
            style="@style/TextAppearance.App.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_s"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="@dimen/text_subtitle"
            app:layout_constraintEnd_toStartOf="@id/imageHeart"
            app:layout_constraintStart_toStartOf="@id/textDishType"
            app:layout_constraintTop_toBottomOf="@id/textDishType"
            tools:text="Chicken strips" />

        <TextView
            android:id="@+id/textTime"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:layout_constraintStart_toStartOf="@id/textDishType"
            app:layout_constraintTop_toBottomOf="@id/textName"
            tools:text="45 min" />

        <TextView
            android:id="@+id/textViewRecipe"
            style="@style/TextAppearance.App.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_s"
            android:text="@string/recipe_view_details"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/textDishType"
            app:layout_constraintTop_toBottomOf="@id/textTime" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>